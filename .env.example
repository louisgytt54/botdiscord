DISCORD_TOKEN=colle_ton_token_ici
CLIENT_ID=id_de_l_application
GUILD_ID=id_du_serveur

# Système de candidatures / affectations (partagé avec le jeu via Supabase).
# ⚠️ SUPABASE_SERVICE_ROLE_KEY contourne la RLS : ne JAMAIS la mettre dans le
# jeu (frontend), uniquement ici, côté bot.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=colle_la_clé_service_role_ici

# /banque (ajout/retrait d'argent en jeu) — réservé à CETTE seule personne,
# quel que soit son rôle Discord. Mode développeur Discord activé, puis
# clic droit sur son profil > Copier l'ID utilisateur.
BANK_ADMIN_DISCORD_ID=colle_l_id_discord_autorisé_ici
